{
  "display_information": {
    "name": "Auto-Reporter",
    "description": "AI-driven status reports from Slack conversations",
    "background_color": "#667eea"
  },
  "features": {
    "bot_user": {
      "display_name": "Auto-Reporter",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/autoreport",
        "description": "Generate status report",
        "usage_hint": "[days]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "users:read",
        "groups:history",
        "groups:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
