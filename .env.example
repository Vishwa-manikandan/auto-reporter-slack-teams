# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_CHANNEL_ID=C1234567890

# Optional: Channel name for display in reports
SLACK_CHANNEL_NAME=engineering

# Slack API timeout (seconds)
SLACK_API_TIMEOUT=30.0


# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/auth/slack/callback
SLACK_SCOPES=channels:read,channels:history,groups:read,groups:history,chat:write,users:read
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_TTL_SECONDS=600


# AI Provider
# mock      - deterministic cue extraction, no model calls (default)
# anthropic - requires AI_API_KEY
# openai    - requires AI_API_KEY
# ollama    - local server, no key; set AI_API_BASE_URL if not localhost:11434
AI_PROVIDER=mock
AI_API_KEY=
# Blank uses the provider default (gpt-4o-mini / claude-3-5-sonnet / llama2)
AI_MODEL=
# Blank uses the provider default (ollama: http://localhost:11434/v1)
AI_API_BASE_URL=
AI_REQUEST_TIMEOUT=60
AI_MAX_OUTPUT_TOKENS=2048
AI_RETRY_LIMIT=3
